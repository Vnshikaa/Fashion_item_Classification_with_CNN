      "source": [
        "def summarize(model, name):\n",
        "    loss, acc = model.evaluate(x_test, y_test, verbose=0)\n",
        "    preds = np.argmax(model.predict(x_test, verbose=0), axis=1)\n",
        "    rep = classification_report(y_test, preds, target_names=CLASS_NAMES, output_dict=True)\n",
        "    f1s = {c: rep[c][\"f1-score\"] for c in CLASS_NAMES}\n",
        "    worst = min(f1s, key=f1s.get)\n",
        "    return {\"Model\": name,\n",
        "            \"Parameters\": model.count_params(),\n",
        "            \"Test accuracy\": round(acc, 4),\n",
        "            \"Test loss\": round(loss, 4),\n",
        "            \"Macro F1\": round(rep[\"macro avg\"][\"f1-score\"], 4),\n",
        "            \"Weakest class\": worst,\n",
        "            \"Weakest class F1\": round(f1s[worst], 3)}\n",
        "\n",
        "comparison = pd.DataFrame([summarize(baseline, \"Baseline CNN\"),\n",
        "                           summarize(improved, \"Improved CNN\")])\n",
        "comparison"
      ]
    },
